model Image {
  id       Int     @id @default(autoincrement())
  alt      String
  src      String
  car      Car     @relation(fields: [carId], references: [id], onDelete: Cascade)
  carId    Int     @map("car_id")
  blurhash String
  isMain   Boolean @default(false) @map("is_main")

  @@map("images")
}
